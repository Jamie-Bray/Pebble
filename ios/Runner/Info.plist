<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Pebble Routines</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Pebble Routines</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Pebble uses the microphone to record short guidance audio for premium routine steps.</string>
	<key>NSCameraUsageDescription</key>
	<string>Pebble uses the camera only when you choose to capture proof photos for routine steps.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Pebble uses your photo library only when you choose an existing proof photo for a routine step.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Pebble saves a copy to Photos only when you choose to export a retained proof photo.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- Google Sign-In redirect. Set in ios/Flutter/GoogleSignIn.xcconfig. -->
				<string>$(GOOGLE_IOS_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.pebbleroutines.shared-routine</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- "Add to Pebble" links (pebbleroutines://r#...), opened by the
				     button on pebbleroutines.com/r and read in lib/main.dart. -->
				<string>pebbleroutines</string>
			</array>
		</dict>
	</array>
	<!-- Pebble opens routines from notifications in Dart, never from URLs
	     pushed to the router. Keep Flutter's deep linking off so a URL the app
	     receives (such as the Google Sign-In redirect, which the plugin
	     handles) is never treated as a page to open. -->
	<key>FlutterDeepLinkingEnabled</key>
	<false/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
